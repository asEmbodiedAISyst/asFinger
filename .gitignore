# Logs
*.log

# Generated build output of the generator (asfinger build ... -o out/<name>)
/out/

# Website: build output and everything the sync scripts generate
# (site/.gitignore lists the same paths for people who work inside site/)
site/dist/
site/.astro/
site/public/py/
site/public/configs/
site/public/assets/
site/public/pyodide/
site/public/llms.txt
site/public/llms-full.txt
site/public/docs-md/
site/public/docs-assets/
site/src/content/docs/

# Fusion add-in: the path of the last config, written at run time
hardware/cad/fusion/asFingerAddIn/settings.json

# Internal documentation. Do not publish it.
docs/internal/

# Recorded episodes and the datasets made from them: large, kept outside git (data/README.md)
/data/*
!/data/README.md

# Robot side: the addresses and identities of the phones, and the raw measurements behind the calibration files
# (the tools write them to calibration/data and refit from there with --from-data)
robot/cameras.local.yaml
calibration/data/

# Seeed's official arm meshes for the twin scene: downloaded by sim/fetch_arm_meshes.py, not redistributed here
# (only SOURCE.md and SHA256SUMS of that folder are kept)
sim/assets/meshes/b601_rs_official/*
!sim/assets/meshes/b601_rs_official/SOURCE.md
!sim/assets/meshes/b601_rs_official/SHA256SUMS
# a local registration of the twin scene (it overrides the camera poses and board geometry of sim/twin.yaml)
sim/twin_registration.yaml
# generated by sim/twin.py when the optional foil crinkle texture is on
sim/assets/foil_*.png

# Parts of the project that are not in this repository yet, and large data
/learning/
*.pt
*.ckpt
*.hdf5
*.h5
wandb/
